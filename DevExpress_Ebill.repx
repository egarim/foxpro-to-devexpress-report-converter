    <Item6 Ref="9" Name="Amy_due" FieldType="String" Expression="ToStr([Table.AmountDue])" />
    <Item7 Ref="10" Name="fmlPreviousBalance" FieldType="Int32" Expression="Table.TotalDue" />
    <Item8 Ref="11" Name="fmlTotalDue" FieldType="Int32" Expression="Iif([Table.IsFinalBill] = True And [Table.TotalDue] = 0, [Table.TotalDue], [Table.TotalDue])" />
    <Item9 Ref="12" Name="fmlTotalDueScanLine" FieldType="String" Expression="PadLeft(ToStr([MasterTotalDue]), 10 , '0')" />
    <Item10 Ref="13" Name="frmAccountNo" FieldType="String" Expression="Replace(Replace(Trim(Replace([AccountNo]+'|','0',' ')),' ','0'),'|','')" DataMember="Table" />
    <Item11 Ref="14" Name="Usage0101" FieldType="Decimal" Expression="Iif([Table.HistoryBilledUsage0101] Is Null, 0, [Table.HistoryBilledUsage0101])" DataMember="Table" />
