    <Item28 Ref="31" Name="TotalDue_WithN2N" FieldType="Int32" Expression="[Table.TotalDue] + [Table.PendReqDeferChrgs]" DataMember="Table" />
    <Item29 Ref="32" Name="frmDaysInService" FieldType="Int32" Expression="Iif([DaysInService01] Is Not Null, [DaysInService01], iif( [DaysInService02] Is Not Null, [Table.DaysInService02], null))" DataMember="Table" />
    <Item30 Ref="33" Name="fmlTotalDuePendingLate" FieldType="Decimal" Expression="[Table.TotalDue] + [Table.PendingLate]" DataMember="Table" />
    <Item31 Ref="34" Name="fmlDiscominusone" FieldType="DateTime" Expression="[Table.OptionalDate] - 1" DataMember="Table" />
    <Item32 Ref="35" Name="fmlCalendar" FieldType="DateTime" Expression="[Table.TranDate] + 25" />
    <Item33 Ref="36" Name="fmloBalanceForward" FieldType="Decimal" Expression="[Table.PreviousBalance] + [Table.Adjustments] + [Table.Payments] + [Table.Penalties] + [Table.Miscellaneous] + [Table.LienFees] + [Table.LienWriteOff] + [Table.Shutoffs] + [Table.Refunds] + [Table.Rebates] + [Table.NSFFees] + [Table.NSFReversals] + [Table.PaymentReversals] + [Table.TransactionReversal] + [Table.DepositApplied] + [Table.DepositIntApplied] - [Table.DepositPayment]" DataMember="Table" />
    <Item34 Ref="37" Name="fmlAccountNo" FieldType="String" Expression="Replace(Replace(Trim(replace([AccountNo]+'|','0',' ')),' ','0'),'|','')" DataMember="Table" />
    <Item35 Ref="38" Name="fmlCompanyAddress" FieldType="String" Expression="Trim(&#xD;&#xA;Iif(IsNullOrEmpty([CompanyAdrs1]),'', NewLine() + Trim([CompanyAdrs1])) +&#xD;&#xA;Iif(IsNullOrEmpty([CompanyAdrs2]), '', NewLine() + Trim([CompanyAdrs2])) +&#xD;&#xA;Iif(IsNullOrEmpty([CompanyAdrs3]), '', NewLine() + [CompanyAdrs3]) +&#xD;&#xA;NewLine() + [CompanyCity] + &#xD;&#xA;iif(IsNullOrEmpty([CompanyStateAbv]),'', ',  ' + [CompanyStateAbv]) + &#xD;&#xA;iif(IsNullOrEmpty([CompanyZip]),'', '  '+ [CompanyZip]) + &#xD;&#xA;iif(Trim(Upper([CompanyCountryName])) = Trim(Upper([CustomerCountryName])), '', NewLine() + [CompanyCountryName] ) &#xD;&#xA;) &#xD;&#xA;&#x9;" DataMember="Table" />
    <Item36 Ref="39" Name="fmlCompanyContactInfo" FieldType="String" Expression="Iif(IsNullOrEmpty([CompanyPhone]),'' , NewLine() + 'Customer Service: ' + [CompanyPhone] ) + &#xD;&#xA;iif(IsNullOrEmpty([CompanyPhone]),'', NewLine()) + 'Pay By Phone: 999-555-1122' + &#xD;&#xA;iif(IsNullOrEmpty([CompanyBillURL]), '', NewLine() + [CompanyBillURL])&#xD;&#xA;+ iif(IsNullOrEmpty([CompanyURL]), '', NewLine() + [CompanyURL])&#xD;&#xA;" DataMember="Table" />
