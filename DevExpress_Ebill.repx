        <Item5 Ref="249" ControlType="XRTable" Name="table8" SizeF="403.10764,455.21533" LocationFloat="405.55084,97.98017" Padding="2,2,0,0,100">
          <Rows>
            <Item1 Ref="250" ControlType="XRTableRow" Name="tableRow12" Weight="1">
              <Cells>
                <Item1 Ref="251" ControlType="XRTableCell" Name="tableCell20" Weight="3" Multiline="true" Text="EXPLANATION OF CHARGES" TextAlignment="MiddleCenter" Font="Arial, 10pt, style=Bold" ForeColor="White" BackColor="247,73,91,94" Borders="Left, Top, Right">
                  <StylePriority Ref="252" UseFont="false" UseForeColor="false" UseBackColor="false" UseBorders="false" UseTextAlignment="false" />
                </Item1>
              </Cells>
            </Item1>
            <Item2 Ref="253" ControlType="XRTableRow" Name="tableRow13" Weight="1">
              <Cells>
                <Item1 Ref="254" ControlType="XRTableCell" Name="tableCell23" Weight="3" Multiline="true" Text="STATEMENT PERIOD" TextAlignment="MiddleLeft" Font="Arial, 9pt, style=Underline" Borders="Left, Right">
                  <StylePriority Ref="255" UseFont="false" UseBorders="false" UseTextAlignment="false" />
                </Item1>
              </Cells>
            </Item2>
            <Item3 Ref="256" ControlType="XRTableRow" Name="tableRow25" Weight="1">
              <Cells>
                <Item1 Ref="257" ControlType="XRTableCell" Name="tableCell21" Weight="3" Multiline="true" Text="Bills are issued bi-monthly (January, March, May, July, September, November) no later than the 15th of the corresponding month. The District is not responsible for lost or undelivered bills. If you haven't received your bill, contact GSCDD or check your online portal immediately." Font="Arial, 9pt" Borders="Left, Right">
                  <StylePriority Ref="258" UseFont="false" UseBorders="false" />
                </Item1>
              </Cells>
            </Item3>
            <Item4 Ref="259" ControlType="XRTableRow" Name="tableRow26" Weight="1">
              <Cells>
                <Item1 Ref="260" ControlType="XRTableCell" Name="tableCell22" Weight="3" Multiline="true" Text="BASE FEES" TextAlignment="BottomLeft" Font="Arial, 9pt, style=Underline" Borders="Left, Right">
                  <StylePriority Ref="261" UseFont="false" UseBorders="false" UseTextAlignment="false" />
                </Item1>
              </Cells>
            </Item4>
            <Item5 Ref="262" ControlType="XRTableRow" Name="tableRow27" Weight="1">
              <Cells>
                <Item1 Ref="263" ControlType="XRTableCell" Name="tableCell24" Weight="3" Multiline="true" Text="Covers fixed operational and maintenance costs for water, wastewater, and irrigation service. Applies even if no water is used. " Font="Arial, 9pt" Borders="Left, Right">
                  <StylePriority Ref="264" UseFont="false" UseBorders="false" />
                </Item1>
              </Cells>
            </Item5>
            <Item6 Ref="265" ControlType="XRTableRow" Name="tableRow28" Weight="1">
              <Cells>
                <Item1 Ref="266" ControlType="XRTableCell" Name="tableCell38" Weight="3" Multiline="true" Text="USAGE FEES" TextAlignment="BottomLeft" Font="Arial, 9pt, style=Underline" Borders="Left, Right">
                  <StylePriority Ref="267" UseFont="false" UseBorders="false" UseTextAlignment="false" />
                </Item1>
              </Cells>
            </Item6>
            <Item7 Ref="268" ControlType="XRTableRow" Name="tableRow29" Weight="1">
              <Cells>
                <Item1 Ref="269" ControlType="XRTableCell" Name="tableCell40" Weight="3" Multiline="true" Text="Reflect variable costs for water, wastewater, and irrigation, billed in1,000-gallon increments. Tiered rates may apply at higher usage." Font="Arial, 9pt" Borders="Left, Right">
                  <StylePriority Ref="270" UseFont="false" UseBorders="false" />
                </Item1>
              </Cells>
            </Item7>
            <Item8 Ref="271" ControlType="XRTableRow" Name="tableRow30" Weight="1">
              <Cells>
                <Item1 Ref="272" ControlType="XRTableCell" Name="tableCell41" Weight="3" Multiline="true" Text="PAYMENT DUE DATE &amp; LATE CHARGES" TextAlignment="BottomLeft" Font="Arial, 9pt, style=Underline" Borders="Left, Right">
                  <StylePriority Ref="273" UseFont="false" UseBorders="false" UseTextAlignment="false" />
                </Item1>
              </Cells>
            </Item8>
            <Item9 Ref="274" ControlType="XRTableRow" Name="tableRow31" Weight="1">
              <Cells>
                <Item1 Ref="275" ControlType="XRTableCell" Name="tableCell42" Weight="3" Multiline="true" Text="Payments are due by the statement due date. A late payment charge of 5% of the overdue amount or $10, whichever is greater, will be assessed on the sixth calendar day after the due date. GSCDD may file a lien for any unpaid balances. &#xA;" Font="Arial, 9pt" Borders="Left, Right">
                  <StylePriority Ref="276" UseFont="false" UseBorders="false" />
                </Item1>
              </Cells>
            </Item9>
            <Item10 Ref="277" ControlType="XRTableRow" Name="tableRow32" Weight="1">
              <Cells>
                <Item1 Ref="278" ControlType="XRTableCell" Name="tableCell43" Weight="3" Multiline="true" Text="DELINQUENT NOTICE &amp; SERVICE INTERRUPTION" TextAlignment="BottomLeft" Font="Arial, 9pt, style=Underline" Borders="Left, Right">
                  <StylePriority Ref="279" UseFont="false" UseBorders="false" UseTextAlignment="false" />
                </Item1>
              </Cells>
            </Item10>
            <Item11 Ref="280" ControlType="XRTableRow" Name="tableRow33" Weight="1">
              <Cells>
                <Item1 Ref="281" ControlType="XRTableCell" Name="tableCell44" Weight="3" Multiline="true" Text="Final notice is mailed and emailed before service is terminated. Keep your email current in the portal. Service may be suspended if bills remain unpaid 30 days after the statement date. Reconnection requires full payment of the total balance and any applicable fees. Payments made after hours will restore service the following business day. &#xA;" Font="Arial, 9pt" Borders="Left, Right">
                  <StylePriority Ref="282" UseFont="false" UseBorders="false" />
                </Item1>
              </Cells>
            </Item11>
            <Item12 Ref="283" ControlType="XRTableRow" Name="tableRow34" Weight="1">
              <Cells>
