  <CalculatedFields>
    <Item1 Ref="4" Name="CUSTOMERBOX" FieldType="String" Expression="[CustomerFullName] +NewLine()+&#xD;&#xA;Trim(&#xD;&#xA;Iif(IsNullOrEmpty([CareOf]), '', Iif(StartsWith(Upper([CareOf]),'C/O '), [CareOf], 'C/O ' +[CareOf] ) + NewLine())  +&#xD;&#xA;Iif(IsNullOrEmpty([CustomerAdrs1]), '' , [CustomerAdrs1]) +&#xD;&#xA;Iif(IsNullOrEmpty([CustomerAdrs2]), '' , NewLine() + [CustomerAdrs2]) +&#xD;&#xA;Iif(IsNullOrEmpty([CustomerAdrs3]), '' , NewLine() + [CustomerAdrs3]) +&#xD;&#xA;NewLine() + &#xD;&#xA;Iif(IsNullOrEmpty([CustomerCity]), '' , [CustomerCity]) +&#xD;&#xA;Iif(IsNullOrEmpty([CustomerStateAbv]), '', ', '+ [CustomerStateAbv])+&#xD;&#xA;Iif(IsNullOrEmpty([CustomerZipCode]), '' ,' ' + [CustomerZipCode]) +&#xD;&#xA;Iif([CustomerCountryAbv] != 'USA', NewLine() + [CustomerCountryAbv], '')&#xD;&#xA;) " />
    <Item2 Ref="5" Name="ocr" FieldType="String" Expression="Replace([StmtAccountNo] + FormatString('{0.##}',[AmountDue]) + [StmtLocationNo] + FormatString('{0:d}',[Due_Date]),'.','')" />
    <Item3 Ref="6" Name="Late_Total" FieldType="Int32" Expression="[Table.AmountDue] + [Table.PendingLate]" />
    <Item4 Ref="7" Name="frmAcctNo" FieldType="String" Expression="Replace(Replace(Trim(replace([AccountNo]+'|','0',' ')),' ','0'),'|','')" />
