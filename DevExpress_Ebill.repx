    <Item23 Ref="26" Name="Usage0113" FieldType="Decimal" Expression="Iif([Table.HistoryBilledUsage0113] Is Null, 0, [Table.HistoryBilledUsage0113])" DataMember="Table" />
    <Item24 Ref="27" Name="frmIsMetered" FieldType="Boolean" Expression="[Table.IsMetered01] Is Null Or Not [Table.IsMetered01]" DataMember="Table" />
    <Item25 Ref="28" Name="scancode" FieldType="String" Expression="'*' + [StmtAccountNo] + '*'" DataMember="Table" />
    <Item26 Ref="29" Name="frmLocationNo" FieldType="String" Expression="Replace(Replace(Trim(Replace([LocationNo]+'|','0',' ')),' ','0'),'|','')" DataMember="Table" />
